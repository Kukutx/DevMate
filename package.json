{
  "name": "devmate-agent",
  "displayName": "DevMate Agent",
  "description": "Give ChatGPT, Claude and any MCP client real hands on your own computer: files, shell, Git, editor diagnostics and local coding agents, without a paid tunnel.",
  "version": "4.0.5",
  "license": "MIT",
  "publisher": "kukutx",
  "icon": "assets/icon.png",
  "homepage": "https://github.com/Kukutx/DevMate#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kukutx/DevMate.git"
  },
  "bugs": {
    "url": "https://github.com/Kukutx/DevMate/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/Kukutx"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "chatgpt",
    "claude",
    "codex",
    "ai agent",
    "multi-agent",
    "developer-tools",
    "obsidian",
    "local-first"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=24"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./vscode-host/runtime-entry.cjs",
  "bin": {
    "devmate": "./runtime/cli.mjs"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrusted%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capability.virtual%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devMate.runtime.start",
        "title": "%command.start%",
        "category": "DevMate",
        "icon": "$(play)"
      },
      {
        "command": "devMate.runtime.stop",
        "title": "%command.stop%",
        "category": "DevMate",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devMate.runtime.restart",
        "title": "%command.restart%",
        "category": "DevMate",
        "icon": "$(debug-restart)"
      },
      {
        "command": "devMate.runtime.registerFolder",
        "title": "%command.registerFolder%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.accessProfile",
        "title": "%command.accessProfile%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.menu",
        "title": "%command.menu%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.status",
        "title": "%command.status%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.open",
        "title": "%command.open%",
        "category": "DevMate",
        "icon": "$(preview)"
      },
      {
        "command": "devMate.runtime.operations",
        "title": "%command.operations%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.call",
        "title": "%command.call%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.selectWorkspace",
        "title": "%command.selectWorkspace%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.doctor",
        "title": "%command.doctor%",
        "category": "DevMate",
        "icon": "$(pulse)"
      },
      {
        "command": "devMate.runtime.copyMcpUrl",
        "title": "%command.copyMcpUrl%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.loginCode",
        "title": "%command.loginCode%",
        "category": "DevMate"
      },
      {
        "command": "devMate.runtime.configureConnection",
        "title": "%command.configureConnection%",
        "category": "DevMate"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "devMate.runtime",
          "name": "DevMate"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "devMate.runtime",
        "label": "DevMate"
      }
    ],
    "configuration": {
      "title": "DevMate",
      "type": "object",
      "properties": {
        "devMate.runtimeInstanceDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.runtimeInstanceDirectory%"
        },
        "devMate.nodeCommandPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.nodeCommandPath%"
        },
        "devMate.runtimePort": {
          "type": "integer",
          "default": 8788,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "machine",
          "description": "%config.runtimePort%"
        },
        "devMate.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "%config.autoStart%"
        },
        "devMate.shareFolders": {
          "scope": "machine",
          "type": "string",
          "enum": [
            "readWrite",
            "readOnly",
            "ask",
            "never"
          ],
          "enumDescriptions": [
            "%config.shareFolders.readWrite%",
            "%config.shareFolders.readOnly%",
            "%config.shareFolders.ask%",
            "%config.shareFolders.never%"
          ],
          "default": "readWrite",
          "description": "%config.shareFolders%"
        },
        "devMate.shareEditorContext": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "description": "%config.shareEditorContext%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "devMate.runtime",
        "contents": "%view.welcome%",
        "when": "!devMate.running"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devMate.runtime.start",
          "when": "view == devMate.runtime && !devMate.running",
          "group": "navigation@1"
        },
        {
          "command": "devMate.runtime.open",
          "when": "view == devMate.runtime && devMate.running",
          "group": "navigation@1"
        },
        {
          "command": "devMate.runtime.stop",
          "when": "view == devMate.runtime && devMate.running",
          "group": "navigation@2"
        },
        {
          "command": "devMate.runtime.copyMcpUrl",
          "when": "view == devMate.runtime && devMate.running",
          "group": "1_connect@1"
        },
        {
          "command": "devMate.runtime.configureConnection",
          "when": "view == devMate.runtime",
          "group": "1_connect@2"
        },
        {
          "command": "devMate.runtime.loginCode",
          "when": "view == devMate.runtime && devMate.running",
          "group": "1_connect@3"
        },
        {
          "command": "devMate.runtime.registerFolder",
          "when": "view == devMate.runtime && devMate.running",
          "group": "2_share@1"
        },
        {
          "command": "devMate.runtime.accessProfile",
          "when": "view == devMate.runtime && devMate.running",
          "group": "2_share@2"
        },
        {
          "command": "devMate.runtime.doctor",
          "when": "view == devMate.runtime",
          "group": "3_runtime@1"
        },
        {
          "command": "devMate.runtime.restart",
          "when": "view == devMate.runtime && devMate.running",
          "group": "3_runtime@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "devMate.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "start",
            "title": "%walkthrough.start.title%",
            "description": "%walkthrough.start.description%",
            "media": {
              "markdown": "vscode-host/walkthrough/start.md"
            },
            "completionEvents": [
              "onCommand:devMate.runtime.start",
              "onContext:devMate.running"
            ]
          },
          {
            "id": "share",
            "title": "%walkthrough.share.title%",
            "description": "%walkthrough.share.description%",
            "media": {
              "markdown": "vscode-host/walkthrough/share.md"
            },
            "completionEvents": [
              "onCommand:devMate.runtime.registerFolder"
            ]
          },
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "markdown": "vscode-host/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:devMate.runtime.copyMcpUrl",
              "onCommand:devMate.runtime.configureConnection"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime-candidate.mjs",
    "build:workbench": "node workbench/build.mjs",
    "check": "node scripts/check-runtime.mjs",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-tests.mjs",
    "test:vscode-host": "node scripts/test-vscode-host.mjs",
    "test:integration": "node --test tests/runtime-integration-auth-resources.test.mjs tests/runtime-integration-jobs-tasks.test.mjs tests/runtime-integration-external.test.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:quick-tunnel": "node scripts/smoke-quick-tunnel.mjs",
    "package:vsix": "node scripts/package-runtime.mjs vscode",
    "package:obsidian": "node scripts/package-runtime.mjs obsidian",
    "package:cli": "node scripts/package-runtime.mjs cli",
    "candidate": "node scripts/release-candidate.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:preflight": "npm run lint && npm run check && npm run test:unit && npm run test:vscode-host && npm run candidate",
    "devmate": "node runtime/cli.mjs",
    "lint": "eslint ."
  },
  "files": [
    "runtime/**",
    "vscode-host/runtime-entry.cjs",
    "vscode-host/walkthrough/**",
    "workbench/**",
    "assets/icon.png",
    "plugin.json",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.10"
  }
}
