{
  "name": "devmate",
  "displayName": "DevMate",
  "description": "Local-first MCP development gateway for ChatGPT, with VS Code, Obsidian, CLI, durable jobs, and remote Runners.",
  "keywords": [
    "mcp",
    "chatgpt",
    "developer-tools",
    "vscode",
    "obsidian",
    "local-first",
    "automation",
    "devtools"
  ],
  "version": "3.6.6",
  "icon": "assets/icon.png",
  "publisher": "local-ai",
  "homepage": "https://github.com/Kukutx/DevMate#readme",
  "bugs": {
    "url": "https://github.com/Kukutx/DevMate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kukutx/DevMate.git"
  },
  "engines": {
    "vscode": "^1.133.0",
    "node": ">=24"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:devMate.start",
    "onCommand:devMate.open",
    "onCommand:devMate.stop",
    "onCommand:devMate.restart",
    "onCommand:devMate.copyUrl",
    "onCommand:devMate.manageWorkspaces",
    "onCommand:devMate.addWorkspace",
    "onCommand:devMate.addReference",
    "onCommand:devMate.clearReferences",
    "onCommand:devMate.doctor",
    "onCommand:devMate.logs",
    "onCommand:devMate.exportSource",
    "onCommand:devMate.copyPrompt",
    "onCommand:devMate.copyContextBundle",
    "onCommand:devMate.copyOAuthApprovalCode",
    "onCommand:devMate.openSettings",
    "onCommand:devMate.ngrokSetup",
    "onCommand:devMate.ngrokSwitchAccount",
    "onCommand:devMate.ngrokClearAccount",
    "onCommand:devMate.openNgrokDashboard",
    "onCommand:devMate.connectionSetup",
    "onCommand:devMate.connectionDoctor",
    "onCommand:devMate.cloudflareSetToken",
    "onCommand:devMate.cloudflareClearToken",
    "onCommand:devMate.openConnectionDocs",
    "onCommand:devMate.copyHostDiagnostics",
    "onCommand:devMate.hostSelfCheck"
  ],
  "main": "./extension-entry-workspaces.js",
  "contributes": {
    "commands": [
      {
        "command": "devMate.start",
        "title": "DevMate: Start"
      },
      {
        "command": "devMate.open",
        "title": "DevMate: Open"
      },
      {
        "command": "devMate.stop",
        "title": "DevMate: Stop"
      },
      {
        "command": "devMate.restart",
        "title": "DevMate: Restart"
      },
      {
        "command": "devMate.copyUrl",
        "title": "DevMate: Copy MCP URL"
      },
      {
        "command": "devMate.manageWorkspaces",
        "title": "DevMate: Manage Workspaces"
      },
      {
        "command": "devMate.addWorkspace",
        "title": "DevMate: Add Workspace"
      },
      {
        "command": "devMate.connectionSetup",
        "title": "DevMate: Connection Setup"
      },
      {
        "command": "devMate.connectionDoctor",
        "title": "DevMate: Connection Doctor"
      },
      {
        "command": "devMate.addReference",
        "title": "DevMate: Add Reference"
      },
      {
        "command": "devMate.clearReferences",
        "title": "DevMate: Clear References"
      },
      {
        "command": "devMate.doctor",
        "title": "DevMate: Doctor"
      },
      {
        "command": "devMate.logs",
        "title": "DevMate: Logs"
      },
      {
        "command": "devMate.exportSource",
        "title": "DevMate: Export Source"
      },
      {
        "command": "devMate.copyPrompt",
        "title": "DevMate: Copy Prompt"
      },
      {
        "command": "devMate.copyContextBundle",
        "title": "DevMate: Copy Context Bundle"
      },
      {
        "command": "devMate.copyOAuthApprovalCode",
        "title": "DevMate: Copy OAuth Approval Code"
      },
      {
        "command": "devMate.openSettings",
        "title": "DevMate: Open Settings"
      },
      {
        "command": "devMate.ngrokSetup",
        "title": "DevMate: Configure ngrok"
      },
      {
        "command": "devMate.ngrokSwitchAccount",
        "title": "DevMate: Switch ngrok Account"
      },
      {
        "command": "devMate.ngrokClearAccount",
        "title": "DevMate: Clear Managed ngrok Account"
      },
      {
        "command": "devMate.openNgrokDashboard",
        "title": "DevMate: Open ngrok Dashboard"
      },
      {
        "command": "devMate.cloudflareSetToken",
        "title": "DevMate: Set Cloudflare Tunnel Token"
      },
      {
        "command": "devMate.cloudflareClearToken",
        "title": "DevMate: Clear Cloudflare Tunnel Token"
      },
      {
        "command": "devMate.openConnectionDocs",
        "title": "DevMate: Open Connection Documentation"
      },
      {
        "command": "devMate.copyHostDiagnostics",
        "title": "DevMate: Copy Host Diagnostics"
      },
      {
        "command": "devMate.hostSelfCheck",
        "title": "DevMate: Host Self-Check"
      }
    ],
    "configuration": {
      "title": "DevMate",
      "type": "object",
      "properties": {
        "devMate.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Bring the complete DevMate connection to Ready automatically after VS Code opens a workspace."
        },
        "devMate.sharedStateDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional shared DevMate state directory override. Leave empty to use the machine-wide ~/.devmate/desktop instance shared by VS Code and Obsidian."
        },
        "devMate.port": {
          "type": "number",
          "default": 8787,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Preferred internal loopback Gateway port. An existing shared Gateway port remains authoritative."
        },
        "devMate.ngrokCommandPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional ngrok executable path."
        },
        "devMate.ngrokUseManagedAccount": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Use the ngrok account saved in VS Code Secret Storage. Fresh installs use the machine's normal ngrok configuration until this is enabled by setup."
        },
        "devMate.ngrokUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional machine-local stable ngrok URL candidate used by Connection Setup. The active runtime URL is shared by the machine-wide desktop instance."
        },
        "devMate.ngrokPoolingEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow ngrok endpoint pooling only when intentionally serving the same trusted DevMate instance from multiple agents."
        },
        "devMate.ngrokTrafficPolicyFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional ngrok Traffic Policy file."
        },
        "devMate.cloudflareCommandPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional cloudflared executable path."
        },
        "devMate.publicUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional machine-local stable HTTPS URL candidate for managed Cloudflare or external ingress. The active runtime URL is shared by the machine-wide desktop instance."
        },
        "devMate.tunnelAutoRestart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Restart an owned public connection process after unexpected exit."
        },
        "devMate.tunnelMaxRestarts": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "scope": "machine",
          "description": "Maximum automatic public connection restarts after unexpected exits."
        },
        "devMate.autoCopyUrl": {
          "type": "boolean",
          "default": true,
          "description": "Copy the public MCP URL only after DevMate reaches verified Ready state."
        },
        "devMate.autoUseCurrentWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Use the current VS Code folder as the active writable workspace."
        },
        "devMate.authenticationMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "oauth"
          ],
          "description": "MCP authentication mode. none is the default single-owner mode for local and public MCP access; oauth is for team/shared member identity."
        },
        "devMate.permissionProfile": {
          "type": "string",
          "default": "fullAccess",
          "enum": [
            "readOnly",
            "balanced",
            "fullAccess"
          ],
          "description": "Permission preset. readOnly blocks mutation; balanced adds destructive-operation guards; fullAccess enables advanced local development operations."
        },
        "devMate.blockDangerousOperations": {
          "type": "boolean",
          "default": true,
          "description": "Block recognized destructive shell and Git patterns in balanced mode. fullAccess intentionally bypasses this guard and should be treated as trusted execution."
        },
        "devMate.confirmBeforePush": {
          "type": "boolean",
          "default": false,
          "description": "Require confirmation before Git push."
        },
        "devMate.allowDirectoryMutations": {
          "type": "boolean",
          "default": false,
          "description": "Allow directory move/delete operations."
        },
        "devMate.defaultCommandTimeoutMs": {
          "type": "number",
          "default": 180000,
          "minimum": 1000,
          "maximum": 1800000,
          "description": "Default command timeout."
        },
        "devMate.maxOutputChars": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum returned command output."
        },
        "devMate.backupRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 3650,
          "description": "Backup retention period."
        },
        "devMate.auditRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 3650,
          "description": "Audit retention period."
        },
        "devMate.maxBackupBytes": {
          "type": "number",
          "default": 536870912,
          "minimum": 1048576,
          "maximum": 10737418240,
          "description": "Maximum retained backup bytes."
        },
        "devMate.maxAuditBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 262144,
          "maximum": 104857600,
          "description": "Maximum audit log bytes."
        },
        "devMate.defaultStartCommand": {
          "type": "string",
          "default": "",
          "description": "Optional project command started after the local Gateway is ready."
        },
        "devMate.publicHealthDetails": {
          "type": "boolean",
          "default": false,
          "description": "Expose detailed public health information."
        },
        "devMate.embeddedRunnerEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the in-process durable Job runner for this VS Code host. Disabled by default; external Runners remain available."
        }
      }
    }
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "build": "npm run version:check && node scripts/build-gateway.mjs",
    "build:obsidian": "npm run version:check && node obsidian-plugin/esbuild.config.mjs && node scripts/check-obsidian-release.mjs --dist",
    "compile": "npm run build",
    "vscode:prepublish": "npm run build",
    "check": "npm run version:check && node scripts/check-repository.mjs && node scripts/check-workflows.mjs && node scripts/check-obsidian-release.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:vscode-host": "node scripts/test-vscode-host.mjs",
    "smoke:gateway": "npm run build && node tests/smoke-gateway.mjs && node tests/smoke-local-capabilities.mjs",
    "package:vsix": "npm run build && vsce package",
    "package:obsidian": "npm run build:obsidian",
    "publish:vsix": "npm run build && vsce publish",
    "devmate": "node scripts/devmate-command.mjs",
    "runner": "node scripts/devmate-runner.mjs"
  },
  "bin": {
    "devmate": "./scripts/devmate-command.mjs",
    "devmate-runner": "./scripts/devmate-runner.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0"
  },
  "license": "MIT",
  "overrides": {
    "@hono/node-server": "2.0.10"
  }
}