{
  "manifest_version": 3,
  "name": "DevMate",
  "version": "4.0.5",
  "description": "Lets the DevMate runtime on this computer use the browser itself: bookmarks, tabs, windows, history, downloads, and pages with their console and network. Requires DevMate.",
  "minimum_chrome_version": "120",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "DevMate" },
  "permissions": ["nativeMessaging", "bookmarks", "tabs", "tabGroups", "history", "downloads", "sessions", "readingList", "topSites", "scripting", "debugger", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
